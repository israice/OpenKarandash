[Desktop Entry]
Version=1.0
Type=Application
Name=Set Screen Resolution
Name[ru]=Разрешение экрана
Comment=Change the virtual screen resolution (Xvfb RandR)
Comment[ru]=Изменить разрешение виртуального экрана
Exec=set-resolution
# "preferences-desktop-display" exists in NEITHER Tango nor Adwaita, so GTK
# fell back to the generic "preferences-desktop" category icon and every
# session showed a filing cabinet where a monitor should be.
Icon=video-display
Terminal=true
Categories=Settings;DesktopSettings;
StartupNotify=true
