{
    // Проект — чистый CommonJS (require/module.exports), без сборки и зависимостей.
    // Явный module гасит подсказку редактора «файл можно перевести в ES-модуль».
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022"
    },
    // Каталоги на точку TypeScript сам не обходит, поэтому хуки перечислены явно —
    // без этого настройки на них не распространяются.
    "include": ["*.js", ".claude/hooks/*.js"]
}
