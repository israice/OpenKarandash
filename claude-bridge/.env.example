# 8788, а не штатный 8787 у claude-bridge: если на этой же машине уже
# крутится другой клон Hermes/claude-bridge (свой процесс, свой порт),
# 8787 может быть занят — см. DOCS/decisions/029
CLAUDE_BRIDGE_TOKEN=
CLAUDE_BRIDGE_TARGET=wsl
CLAUDE_BRIDGE_HOST=127.0.0.1
CLAUDE_BRIDGE_PORT=8788
CLAUDE_BRIDGE_CWD=/mnt/c/0_PROJECTS/OpenKarandash
HERMES_API_KEY=
HERMES_API_URL=http://127.0.0.1:8642/v1
# Уровень рассуждений claude на каждом ходе (low|medium|high|xhigh|max); пусто —
# как решит CLI. Один на весь мост: смена посреди разговора сбрасывает кеш.
CLAUDE_BRIDGE_EFFORT=
# 1 — продолжать сессию CLI между шагами агента, история читается из кеша
# (claude-bridge/session_cache.py); 0 — каждый запрос полной перепиской
CLAUDE_BRIDGE_SESSION_REUSE=1
