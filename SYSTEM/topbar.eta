<% /* Верхнее меню пульта — вся его статичная разметка в одном файле.

    Рисует сервер (DOCS/decisions/005). Шаблон подставляется в страницу на месте
    {{TOPBAR}} — renderPage в SYSTEM/core/version.js, — и тем же модулем
    отдаётся маршрутом /api/fragment/topbar (SYSTEM/topbar-server.js).

    Меню приходит вместе со страницей одной частью. Раньше половину верхнего
    ряда дописывали скрипты уже после разбора страницы: шестерёнку настроек
    рисовала settings-markup.js и вставляла в .topbar, а рядом с ней кнопку
    Karandash вставлял karandash.js. Обе кнопки дописывались на глазах у
    человека, ряд сдвигался влево, и порядок верхнего ряда зависел от того,
    какой файл успел выполниться раньше.

    Собственного дизайна здесь нет: в шаблон переехало то, что лежало в
    SYSTEM/index.html, плюс эти две кнопки и меню «+».

    Динамика живёт в клиенте: пустые слоты под панели страниц кнопки «+» и
    сами кнопки созданных страниц добавляет SYSTEM/new-button.js — их список
    хранится на сервере (/api/pages), разметки в файле быть не может.

    Правка этого файла перезагружает страницу целиком: у .topbar нет hx-get,
    и точечному событию fragment:topbar не на что лечь — так же, как на правку
    SYSTEM/index.html. Подмены без перезагрузки здесь и не может быть: скрипты
    вешают обработчики на узлы этого меню при старте (SYSTEM/tabs.js,
    SYSTEM/toolbar-menu.js, PROJECTS/Karandash/karandash.js), и подмена
    содержимого .topbar оставила бы их на мёртвых узлах. */ %>

<!-- Панели самих страниц кнопки «+» (например, выбор сессии у Feed) сюда не
     пишутся: их слоты заводит SYSTEM/new-button.js, а рисует сама страница. -->
<div class="flow-canvas__zoom btn-group" id="flowZoomPanel" role="toolbar" aria-label="Page tools" hidden>
    <select class="flow-canvas__zoom-select" id="flowSessionSelect" title="Open session in Flow" hidden>
        <option value="">Session…</option>
    </select>
    <button type="button" class="flow-canvas__zoom-btn btn-group__btn" id="flowZoomOut" title="Zoom out">−</button>
    <span class="flow-canvas__zoom-value" id="flowZoomValue">100%</span>
    <button type="button" class="flow-canvas__zoom-btn btn-group__btn" id="flowZoomIn" title="Zoom in">+</button>
    <button type="button" class="flow-canvas__zoom-btn btn-group__btn" id="flowLayoutReset" title="Lay nodes out as a tree without overlaps">⊞</button>
    <button type="button" class="flow-canvas__zoom-btn btn-group__btn" id="flowCanvasReset" title="Reset canvas: remove all added nodes">↺</button>
</div>

<!-- Левая панель тулбара: кнопка «Новое» и созданные ею страницы (SYSTEM/new-button.js) -->
<div class="toolbar btn-group toolbar--left" role="toolbar" aria-label="New projects">
    <button type="button" class="icon-button btn-group__btn" id="newButton" data-new-page="true" aria-label="New" title="New">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14"></path>
        </svg>
    </button>
</div>

<!-- Группа дополнительных кнопок (не страницы) -->
<div class="toolbar btn-group toolbar--actions" role="toolbar" aria-label="Actions">
    <!-- Второй «+»: та же кнопка, что и newButton слева, — заводит страницу
         в PROJECTS/ так же (SYSTEM/new-button.js). Кнопки создаваемых
         страниц по-прежнему появляются в левой группе рядом с newButton -->
    <button type="button" class="icon-button btn-group__btn" id="newPageButton" data-new-page="true" aria-label="New" title="New">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14"></path>
        </svg>
    </button>
    <button type="button" class="icon-button btn-group__btn" aria-label="Search" title="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m21 21-4.35-4.35"></path>
        </svg>
    </button>
    <button type="button" class="icon-button btn-group__btn" aria-label="Refresh" title="Refresh">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"></path>
        </svg>
    </button>
    <button type="button" class="icon-button btn-group__btn" aria-label="Favorite" title="Favorite">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path>
        </svg>
    </button>
    <button type="button" class="icon-button btn-group__btn" aria-label="Notifications" title="Notifications">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
    </button>
</div>

<!-- Новая кнопка здесь — только с иконкой, ещё не занятой соседями по .btn-group__btn -->
<div class="toolbar btn-group" role="toolbar" aria-label="System projects">
    <button type="button" class="icon-button btn-group__btn" id="telegramButton" data-view="telegram" aria-pressed="false" aria-label="Telegram" title="Telegram">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 4 3 11l6 2 2 6z"></path>
            <path d="M9 13 21 4l-8 16-2-5z"></path>
        </svg>
    </button>
    <button type="button" class="icon-button btn-group__btn" id="flowButton" data-view="flow" aria-pressed="false" aria-label="Flow" title="Flow">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="6" rx="1.5"></rect>
            <rect x="14" y="15" width="7" height="6" rx="1.5"></rect>
            <path d="M6.5 9v6a3 3 0 0 0 3 3H14"></path>
        </svg>
    </button>
    <button type="button" class="icon-button btn-group__btn" id="kanbanButton" data-view="kanban" aria-pressed="false" aria-label="Kanban" title="Kanban">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="5" height="16" rx="1.5"></rect>
            <rect x="9.5" y="4" width="5" height="11" rx="1.5"></rect>
            <rect x="16" y="4" width="5" height="14" rx="1.5"></rect>
        </svg>
    </button>
    <button type="button" class="icon-button btn-group__btn" id="chatButton" data-view="chat" aria-pressed="false" aria-label="Sessions" title="Sessions">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12a8 8 0 0 1-8 8H7l-4 3v-5.5A8 8 0 0 1 11 4h2a8 8 0 0 1 8 8z"></path>
        </svg>
        <span id="chatButtonBadge" class="icon-button__badge"></span>
    </button>
    <button type="button" class="icon-button btn-group__btn" id="bookButton" data-view="book" aria-pressed="false" aria-label="Book" title="Book">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"></path>
            <path d="M4 5.5v15A2.5 2.5 0 0 0 6.5 23H20"></path>
        </svg>
    </button>
    <button type="button" class="icon-button btn-group__btn" id="addButton" aria-label="Add" title="Add">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12l7 7 7-7"></path>
        </svg>
    </button>

    <!-- Меню кнопки «+» (SYSTEM/toolbar-menu.js): сама оболочка здесь, строки
         по кнопкам тулбара собирает скрипт при открытии — там их список -->
    <ul class="toolbar-menu" id="toolbarMenu" role="menu" aria-labelledby="addButton" hidden></ul>
</div>

<!-- Кнопка Karandash: режим комментариев к элементам интерфейса. Логика и рамка
     с попапом — PROJECTS/Karandash/karandash.js -->
<div class="toolbar" id="karandashToolbar" role="toolbar" aria-label="Karandash">
    <button type="button" class="icon-button" id="karandashButton" aria-pressed="false" aria-label="Karandash" title="Karandash">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
        </svg>
    </button>
</div>

<!-- Кнопка-шестерёнка и её меню — PROJECTS/Settings/settings.js -->
<div class="settings" id="settings" role="toolbar" aria-label="Settings">
    <button
        type="button"
        class="icon-button settings__button"
        id="settingsButton"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="settingsMenu"
        aria-label="Settings"
        title="Settings"
    >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
    </button>

    <ul class="settings__menu" id="settingsMenu" role="menu" aria-labelledby="settingsButton" hidden>
        <li role="none"><button type="button" class="settings__item" role="menuitem">Login</button></li>
        <li role="none"><button type="button" class="settings__item" role="menuitem">Placeholder_2</button></li>
        <li role="none"><div class="settings__separator"></div></li>
        <li role="none"><button type="button" class="settings__item" role="menuitem">Settings</button></li>
    </ul>
</div>