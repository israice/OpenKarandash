###############################################################################
#  Web Linux Desktop - configuration
#
#  Copy to .env and edit:   cp .env.example .env
#  Docker Compose reads .env automatically.
#
#  Nothing here has to be filled in. The manager has auto-login: open the URL
#  in a browser and you are in, no password.
###############################################################################

# --- auto-login (the default, no password anywhere) -------------------------
# 1 = anyone who can open the URL is logged in as MANAGER_USER.
# 0 = every request needs HTTP Basic credentials (a password prompt).
# Auto-login means "reaching the URL is the login". Keep MANAGER_BIND on
# 127.0.0.1, or put a reverse proxy with its own authentication in front of
# this service before enabling it for other machines.
MANAGER_AUTO_LOGIN=1
MANAGER_USER=admin

# --- authentication (only needed with MANAGER_AUTO_LOGIN=0, or for scripts) --
# Optional while auto-login is on. Generate one if you set it:
#   openssl rand -base64 24
MANAGER_PASSWORD=
# Optional bearer token for scripting, so a password does not end up in `ps`.
# If set, scripts/desktop-session.sh uses it instead of HTTP Basic.
MANAGER_API_TOKEN=

# --- where the browser reaches the manager ----------------------------------
# 127.0.0.1 = only this machine (works in a browser on this host).
# 0.0.0.0   = reachable from the network: only with auto-login OFF, or behind
#             an authenticating reverse proxy.
MANAGER_BIND=127.0.0.1
MANAGER_PORT=8080
# Set when a reverse proxy serves the manager, e.g. https://desktop.example.com
PUBLIC_BASE_URL=

# --- session defaults -------------------------------------------------------
DESKTOP_IMAGE=webdesktop:lxde
SESSION_RESOLUTION=1440x900
# RFB password for the session (max 8 chars, protocol limit). Empty = the
# session is reachable only through the authenticated manager.
SESSION_VNC_PASSWORD=

# --- per-session hard limits ------------------------------------------------
SESSION_MEMORY_MB=512
SESSION_CPUS=0.5
SESSION_PIDS_LIMIT=512
SESSION_TMPFS_MB=64

# --- admission control ------------------------------------------------------
MAX_SESSIONS=20
# Free RAM that must remain BEFORE a new session is admitted.
MIN_FREE_MEMORY_MB=700
# Free RAM that must remain AFTER adding the new session's limit.
RESERVE_MEMORY_MB=512
MIN_FREE_DISK_MB=2048
# 0 disables the load check.
MAX_LOAD_PER_CPU=4.0
# queue | reject
OVERLOAD_ACTION=queue
MAX_QUEUE=10
QUEUE_TIMEOUT_S=120

# --- shutdown -----------------------------------------------------------------
# Session containers are created through the Docker API, so `docker compose
# down` cannot stop them and a running one keeps the internal sessions network
# busy ("Resource is still in use"). The manager stops its own containers on
# SIGTERM - never removes them - and resumes them on its next start.
STOP_SESSIONS_ON_SHUTDOWN=1

LOG_LEVEL=INFO
