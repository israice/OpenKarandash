[Desktop Entry]
Version=1.0
Type=Application
Name=Restart Desktop
Name[ru]=Перезапустить рабочий стол
Comment=Restart the LXDE desktop session
Comment[ru]=Перезапуск сеанса LXDE
Exec=lxde-restart
# "application-x-executable" is a generic diamond and said nothing about what
# the shortcut does; this is the standard name for "the session itself".
Icon=preferences-system-session
Terminal=false
Categories=System;
