{
    "enabledPlugins": {
        "typescript-lsp@claude-plugins-official": false
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/file-lock.js",
                        "timeout": 100
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/syntax-check.js",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
