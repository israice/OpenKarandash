<% /* Панель наблюдения на Home. Всё, что здесь есть, считается из списка сессий
    на сервере; карточка Providers в панель не входит — её состояние живёт
    только в браузере (подключение провайдера из настроек).

    Все куски подменяются через hx-swap-oob по id: сам запрос идёт с hx-swap="none"
    от невидимого элемента. Так разметку index.html и сетку .observation трогать
    не нужно — обновляется ровно содержимое трёх списков и двух плиток. */ %>
<ul class="obs-card__stats" id="obsStats" hx-swap-oob="true">
    <li><span>Messages total</span><strong><%= it.messages %></strong></li>
    <li><span>Sessions in 24 hours</span><strong><%= it.today %></strong></li>
    <li><span>Last activity</span><strong><%= it.lastActive %></strong></li>
    <% /* суждения о ходах: их поломка ничего не роняет и потому невидима —
        поэтому состояние стоит здесь, а не прячется в настройках */ %>
    <li><span>Turn judgment</span><strong class="obs-card__stat--<%= it.judgment.kind %>"><%= it.judgment.text %></strong></li>
    <% /* сколько сессий просят вмешаться: суждение о ходе считалось и раньше,
        но видно было только в самой ленте (DOCS/decisions/055). Ноль — тоже
        ответ, поэтому строка не прячется */ %>
    <li><span>Needs you</span><strong<% if (it.attention) { %> class="obs-card__stat--error"<% } %>><%= it.attention %></strong></li>
</ul>

<ul class="obs-list" id="obsRunningList" hx-swap-oob="true">
    <% if (!it.running.length) { %>
        <li class="obs-list__empty">Nothing is running right now</li>
    <% } %>
    <% it.running.forEach((session) => { %>
        <li>
            <button type="button" class="obs-list__item" data-session-id="<%= session.id %>" data-running="1">
                <span class="obs-list__dot obs-list__dot--running"></span>
                <span class="obs-list__title"><%= session.title %></span>
                <span class="obs-list__meta">running…</span>
            </button>
        </li>
    <% }) %>
</ul>

<ul class="obs-list" id="obsRecentList" hx-swap-oob="true">
    <% if (!it.recent.length) { %>
        <li class="obs-list__empty">No sessions yet</li>
    <% } %>
    <% it.recent.forEach((session) => { %>
        <li>
            <button type="button" class="obs-list__item" data-session-id="<%= session.id %>"<% if (session.running) { %> data-running="1"<% } %>>
                <span class="obs-list__dot<% if (session.running) { %> obs-list__dot--running<% } %>"></span>
                <span class="obs-list__title"><%= session.title %></span>
                <span class="obs-list__meta"><%= session.meta %></span>
            </button>
        </li>
    <% }) %>
</ul>

<span class="stat-tile__value" id="totalCount" hx-swap-oob="true"><%= it.total %></span>
<span class="stat-tile__value" id="activeCount" hx-swap-oob="true"><%= it.active %></span>
