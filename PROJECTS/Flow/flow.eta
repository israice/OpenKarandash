                                    <span class="flow-node__menu-label">MCP</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="prompt" aria-pressed="false" title="System Prompt — how should I behave: basic instructions, rules and working principles of the agent">
                                    <span class="flow-node__menu-icon" aria-hidden="true">📜</span>
                                    <span class="flow-node__menu-label">System Prompt</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="soul" aria-pressed="false" title="Soul — who am I: personality, character, values and interaction style">
