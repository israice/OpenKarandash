                    <!-- личная стартовая нода трёх профилей без собственной визуальной
                         особенности — Secretary, UI developer, HR. Один общий шаблон вместо
                         ещё трёх копий разметки QA/Backend: заголовок, подзаголовок, текст
                         тела и пути файлов профиля подставляет applyProfileMeta в flow.js по
                         записи PROFILE_META сразу после клонирования (ensureRootNode) —
                         здесь только пустая оболочка, одинаковая для всех трёх -->
                    <template id="flowNodeProfileTemplate">
                        <div class="flow-node flow-node--profile">
                            <nav class="flow-node__menu" aria-label="Profile menu">
                                <button type="button" class="flow-node__menu-item" data-panel="mcp" aria-pressed="false" title="MCP servers: pick which ones to use in this session">
