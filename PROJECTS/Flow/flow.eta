<% /* Разметка вкладки Flow: боковая панель со списком flows и полотно
   сверху. Отдаётся маршрутом /api/fragment/flow; контейнер-инициатор
   hx-get="/api/fragment/flow" с hx-swap="innerHTML" стоит в
   SYSTEM/index.html и принимает ответ своим innerHTML. */ %>
        <nav class="side-nav" id="flowNav" aria-label="Flows">
            <h2 class="side-nav__title side-nav__title--collapsible" id="flowFlowsTitle">
                <span>Flows</span>
                <button type="button" class="side-nav__arrow side-nav__arrow--active" id="flowFlowsAddBtn" title="Add flow">+</button>
            </h2>

        </nav>

        <div class="view__content">
            <div class="flow-canvas" id="flowCanvas">
                <div class="flow-canvas__surface" id="flowSurface">
                    <svg class="flow-canvas__edges" id="flowEdges">
                        <defs>
                            <marker id="flowArrowHead" markerWidth="10" markerHeight="10" refX="7" refY="3.5" orient="auto">
                                <path d="M0,0 L7,3.5 L0,7 Z" fill="#6ea8fe"></path>
                            </marker>
                        </defs>
                        <path id="flowEdgeStart" fill="none" stroke="#6ea8fe" stroke-width="2" marker-end="url(#flowArrowHead)" style="pointer-events: stroke;"></path>
                    </svg>
                    <div class="flow-node" id="flowNodeStart">
                        <div class="flow-node__header">
                            <span class="flow-node__avatar">▶️</span>
                            <span class="flow-node__titles">
                                <span class="flow-node__title-row">
                                    <span class="flow-node__title">New</span>
                                    <span class="flow-node__badge">
                                        <span class="flow-node__badge-dot"></span>
                                        From User
                                    </span>
                                </span>
                                <span class="flow-node__subtitle" id="flowNodeStartMeta"></span>
                            </span>
                        </div>
                        <div class="flow-node__body">The starting point of the flow: a new task lands here before the secretary distributes it across the board columns.</div>
                        <button type="button" class="flow-node__add-bottom" title="Add a node (or drag onto another node to connect)">+</button>
                        <button type="button" class="flow-node__add-right" title="Add a node (or drag onto another node to connect)">+</button>
                    </div>
                    <div class="flow-node" id="flowNodeSecretary">
                        <div class="flow-node__header">
                            <span class="flow-node__avatar">🗂️</span>
                            <span class="flow-node__titles">
                                <span class="flow-node__title-row">
                                    <span class="flow-node__title">Secretary</span>
                                    <span class="flow-node__badge">
                                        <span class="flow-node__badge-dot"></span>
                                        Temporary node
                                    </span>
                                </span>
                                <span class="flow-node__subtitle">Dispatcher agent · Executor</span>
                            </span>
                        </div>
                        <div class="flow-node__body">Receives tasks and distributes them across the board columns.</div>
                        <div class="flow-node__footer flow-node__footer--controls">
                            <select class="flow-node__control" id="flowNodeSecretaryProvider" aria-label="Provider"></select>
                            <select class="flow-node__control" id="flowNodeSecretaryModel" aria-label="Model"></select>
                            <select class="flow-node__control" id="flowNodeSecretaryEffort" aria-label="Effort"></select>
                        </div>
                        <button type="button" class="flow-node__add-bottom" title="Add a node (or drag onto another node to connect)">+</button>
                        <button type="button" class="flow-node__add-right" title="Add a node (or drag onto another node to connect)">+</button>
                    </div>
                    <!-- личная стартовая нода миньона QA: своя карточка, с которой
                         начинается его канвас (см. PERSONAL_ROOTS в flow.js). Логики
                         за ней пока нет — только разметка, её и улучшаем дальше -->
                    <template id="flowNodeQaTemplate">
                        <div class="flow-node flow-node--qa">
                            <!-- вертикальное меню в левой части ноды: кнопки «иконка +
                                 название» столбиком. Кнопка с data-panel показывает
                                 вместо правой колонки одноимённую панель (flow.js),
                                 у остальных обработчиков пока нет -->
                            <nav class="flow-node__menu" aria-label="QA menu">
                                <button type="button" class="flow-node__menu-item" data-panel="mcp" aria-pressed="false" title="MCP-серверы для тестировщика: выбери, какими пользоваться в этой сессии">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🔌</span>
                                    <span class="flow-node__menu-label">MCP</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="prompt" aria-pressed="false" title="System Prompt — как я должен себя вести: основные инструкции, правила и принципы работы агента">
                                    <span class="flow-node__menu-icon" aria-hidden="true">📜</span>
                                    <span class="flow-node__menu-label">System Prompt</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="soul" aria-pressed="false" title="Soul — кто я: личность, характер, ценности и стиль взаимодействия">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🫀</span>
                                    <span class="flow-node__menu-label">Soul</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="model" aria-pressed="false" title="Model — чем я думаю: выбранная языковая модель и провайдер, через которых работает агент">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🤖</span>
                                    <span class="flow-node__menu-label">Model</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="thinking" aria-pressed="false" title="Thinking — насколько глубоко я думаю: уровень рассуждения, reasoning/thinking budget и связанные параметры">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🧠</span>
                                    <span class="flow-node__menu-label">Thinking</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="tools" aria-pressed="false" title="Tools — что я умею делать: доступные встроенные и подключённые инструменты для выполнения действий">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🧰</span>
                                    <span class="flow-node__menu-label">Tools</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="skills" aria-pressed="false" title="Skills — какие специализированные способности у меня есть: набор инструкций и навыков под конкретные задачи">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🎓</span>
                                    <span class="flow-node__menu-label">Skills</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="agents" aria-pressed="false" title="Agents — каких других агентов я могу привлечь: доступные субагенты и правила их использования">
                                    <span class="flow-node__menu-icon" aria-hidden="true">👥</span>
                                    <span class="flow-node__menu-label">Agents</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="memory" aria-pressed="false" title="Memory — что я помню: сохраняемый контекст, факты, предпочтения и накопленные знания между сессиями">
                                    <span class="flow-node__menu-icon" aria-hidden="true">💾</span>
                                    <span class="flow-node__menu-label">Memory</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="permissions" aria-pressed="false" title="Permissions — что мне разрешено: ограничения и политики доступа к файлам, shell, сети, внешним действиям и другим ресурсам">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🔐</span>
                                    <span class="flow-node__menu-label">Permissions</span>
                                </button>
                            </nav>
                            <!-- правая колонка: всё прежнее содержимое карточки. Обёртка
                                 нужна только под раскладку в две колонки — селекторы
                                 flow.js ищут потомков ноды и её переживают -->
                            <div class="flow-node__main">
                                <div class="flow-node__header">
                                    <span class="flow-node__titles">
                                        <span class="flow-node__title-row">
                                            <span class="flow-node__title">QA</span>
                                        </span>
                                        <span class="flow-node__subtitle">Quality gate · Entry point</span>
                                    </span>
                                </div>
                                <div class="flow-node__body">The starting point of the QA flow: everything the tester checks grows from this node.</div>
                                <!-- те же провайдер/модель/effort, что у Секретаря и обычных
                                     нод: классы общие, поэтому заполняет их та же
                                     populateNodeAgentSelects в flow.js -->
                                <div class="flow-node__footer flow-node__footer--controls">
                                    <select class="flow-node__control flow-node__provider" aria-label="Provider"></select>
                                    <select class="flow-node__control flow-node__model" aria-label="Model"></select>
                                    <select class="flow-node__control flow-node__effort" aria-label="Effort"></select>
                                </div>
                            </div>
                            <!-- правая колонка в режиме MCP: список серверов, которыми
                                 обычно пользуется QA. Сами строки рисует flow.js по
                                 списку QA_MCPS — здесь только оболочка с поиском -->
                            <div class="flow-node__panel flow-node__panel--mcp" hidden>
                                <div class="flow-node__panel-title flow-node__panel-title--with-action">
                                    <span>MCP servers</span>
                                    <!-- иконка md-файла: открывает файл из data-file в
                                         общем редакторе (обработчик — flow.js) -->
                                    <button type="button" class="flow-node__panel-file" data-file="PROJECTS/Flow/profiles/QA/mcp.json" title="Open mcp.json" aria-label="Open mcp.json">📄</button>
                                </div>
                                <input type="search" class="flow-node__mcp-search" placeholder="Search MCP…" aria-label="Search MCP">
                                <div class="flow-node__mcp-list"></div>
                            </div>
                            <!-- правая колонка в режиме System Prompt: как агент
                                 должен себя вести — инструкции, правила, принципы. Поля
                                 рисует flow.js по списку QA_PROMPT — здесь только оболочка -->
                            <div class="flow-node__panel flow-node__panel--prompt" hidden>
                                <div class="flow-node__panel-title flow-node__panel-title--with-action">
                                    <span>System Prompt</span>
                                    <button type="button" class="flow-node__panel-file" data-file="PROJECTS/Flow/profiles/QA/SYSTEM.md" title="Open SYSTEM.md" aria-label="Open SYSTEM.md">📄</button>
                                </div>
                                <div class="flow-node__panel-hint">How should I behave: basic instructions, rules and working principles of the agent.</div>
                                <div class="flow-node__prompt-list"></div>
                            </div>
                            <!-- правая колонка в режиме Soul: кто этот агент —
                                 личность, характер, ценности, стиль. Поля рисует
                                 flow.js по списку QA_SOUL — здесь только оболочка -->
                            <div class="flow-node__panel flow-node__panel--soul" hidden>
                                <div class="flow-node__panel-title flow-node__panel-title--with-action">
                                    <span>Soul</span>
                                    <button type="button" class="flow-node__panel-file" data-file="PROJECTS/Flow/profiles/QA/APPEND_SYSTEM.md" title="Open APPEND_SYSTEM.md" aria-label="Open APPEND_SYSTEM.md">📄</button>
                                </div>
                                <div class="flow-node__panel-hint">Who am I: personality, character, values and interaction style.</div>
                                <div class="flow-node__soul-list"></div>
                            </div>
                            <!-- правая колонка в режиме Thinking: насколько глубоко
                                 агент рассуждает — уровень рассуждения, бюджет
                                 размышлений и связанные параметры. Поля рисует flow.js
                                 по списку QA_THINKING — здесь только оболочка -->
                            <div class="flow-node__panel flow-node__panel--thinking" hidden>
                                <div class="flow-node__panel-title flow-node__panel-title--with-action">
                                    <span>Thinking</span>
                                    <button type="button" class="flow-node__panel-file" data-file="PROJECTS/Flow/profiles/QA/settings.json" title="Open settings.json" aria-label="Open settings.json">📄</button>
                                </div>
                                <div class="flow-node__panel-hint">How deep do I think: reasoning level, thinking budget and related parameters.</div>
                                <div class="flow-node__thinking-list"></div>
                            </div>
                            <!-- правая колонка в режиме Tools: что агент умеет
                                 делать — встроенные и подключённые инструменты для
                                 действий. Поля рисует flow.js по списку QA_TOOLS — здесь
                                 только оболочка -->
                            <div class="flow-node__panel flow-node__panel--tools" hidden>
                                <div class="flow-node__panel-title flow-node__panel-title--with-action">
                                    <span>Tools</span>
                                    <button type="button" class="flow-node__panel-file" data-file="settings.json" title="Open settings.json" aria-label="Open settings.json">📄</button>
                                </div>
                                <div class="flow-node__panel-hint">What can I do: the built-in and connected tools available for taking actions.</div>
                                <div class="flow-node__tools-list"></div>
                            </div>
                            <!-- правая колонка в режиме Permissions: границы агента в
                                 терминах pi — список инструментов, состав сессии,
                                 доверие проекту, гейт вызовов и изоляция. Поля рисует
                                 flow.js по списку QA_PERMISSIONS, иконка ведёт в сам
                                 гейт профиля (PROJECTS/Flow/profiles/QA) -->
                            <div class="flow-node__panel flow-node__panel--permissions" hidden>
                                <div class="flow-node__panel-title flow-node__panel-title--with-action">
                                    <span>Permissions</span>
                                    <button type="button" class="flow-node__panel-file" data-file="PROJECTS/Flow/profiles/QA/extensions/permission-gate.ts" title="Open permission-gate.ts" aria-label="Open permission-gate.ts">📄</button>
                                </div>
                                <div class="flow-node__panel-hint">What am I allowed to do. pi has no permission modes and no sandbox: the limits are the tool allowlist, what loads into the session, project trust, the tool_call gate and outside isolation.</div>
                                <div class="flow-node__permissions-list"></div>
                            </div>
                            <!-- правая колонка в режиме Model: чем агент думает —
                                 провайдер и модель. Внутренний префикс классов здесь
                                 llm, а не model: класс .flow-node__model уже занят
                                 селектором модели в подвале карточки. Поля рисует
                                 flow.js по списку QA_MODEL -->
                            <div class="flow-node__panel flow-node__panel--model" hidden>
                                <div class="flow-node__panel-title flow-node__panel-title--with-action">
                                    <span>Model</span>
                                    <button type="button" class="flow-node__panel-file" data-file="PROJECTS/Flow/profiles/QA/settings.json" title="Open settings.json" aria-label="Open settings.json">📄</button>
                                </div>
                                <div class="flow-node__panel-hint">What do I think with: the language model and the provider the agent runs through.</div>
                                <div class="flow-node__llm-list"></div>
                            </div>
                            <!-- правая колонка в режиме Skills: специализированные
                                 навыки агента. Своего файла в профиле у них пока нет
                                 (у pi навыки лежат в .agents/skills проекта), поэтому
                                 заголовок без иконки 📄 -->
                            <div class="flow-node__panel flow-node__panel--skills" hidden>
                                <div class="flow-node__panel-title">Skills</div>
                                <div class="flow-node__panel-hint">What special abilities do I have: sets of instructions and skills for particular tasks.</div>
                                <div class="flow-node__skills-list"></div>
                            </div>
                            <!-- правая колонка в режиме Agents: кого агент может
                                 позвать себе на помощь. Файла в профиле тоже пока
                                 нет — только описание словами -->
                            <div class="flow-node__panel flow-node__panel--agents" hidden>
                                <div class="flow-node__panel-title">Agents</div>
                                <div class="flow-node__panel-hint">Which other agents can I call in: the subagents available and the rules for using them.</div>
                                <div class="flow-node__agents-list"></div>
                            </div>
                            <!-- правая колонка в режиме Memory: что агент помнит между
                                 сессиями. Файла в профиле тоже пока нет -->
                            <div class="flow-node__panel flow-node__panel--memory" hidden>
                                <div class="flow-node__panel-title">Memory</div>
                                <div class="flow-node__panel-hint">What do I remember: the context, facts and preferences kept between sessions.</div>
                                <div class="flow-node__memory-list"></div>
                            </div>
                            <button type="button" class="flow-node__add-bottom" title="Add a node (or drag onto another node to connect)">+</button>
                            <button type="button" class="flow-node__add-right" title="Add a node (or drag onto another node to connect)">+</button>
                        </div>
                    </template>
                    <!-- личная стартовая нода бэкенд-разработчика: тот же двухколоночный
                         каркас, что у QA (шаблон/меню/панели), но всё содержимое своё —
                         профиль здесь настоящий каталог профиля, а не pi.
                         Панели с иконкой 📄 ведут в PROJECTS/Flow/profiles/Backend developer/
                         config.yaml или SOUL.md — один физический файл на несколько панелей,
                         в отличие от QA, где у каждой панели свой файл -->
                    <template id="flowNodeBackendTemplate">
                        <div class="flow-node flow-node--backend">
                            <nav class="flow-node__menu" aria-label="Backend developer menu">
                                <button type="button" class="flow-node__menu-item" data-panel="mcp" aria-pressed="false" title="MCP-серверы для бэкенд-разработчика: выбери, какими пользоваться в этой сессии">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🔌</span>
                                    <span class="flow-node__menu-label">MCP</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="prompt" aria-pressed="false" title="System Prompt — как я должен себя вести: основные инструкции, правила и принципы работы агента">
                                    <span class="flow-node__menu-icon" aria-hidden="true">📜</span>
                                    <span class="flow-node__menu-label">System Prompt</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="soul" aria-pressed="false" title="Soul — кто я: личность, характер, ценности и стиль взаимодействия">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🫀</span>
                                    <span class="flow-node__menu-label">Soul</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="model" aria-pressed="false" title="Model — чем я думаю: выбранная языковая модель и провайдер, через которых работает агент">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🤖</span>
                                    <span class="flow-node__menu-label">Model</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="thinking" aria-pressed="false" title="Thinking — насколько глубоко я думаю: уровень рассуждения, reasoning/thinking budget и связанные параметры">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🧠</span>
                                    <span class="flow-node__menu-label">Thinking</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="tools" aria-pressed="false" title="Tools — что я умею делать: доступные встроенные и подключённые инструменты для выполнения действий">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🧰</span>
                                    <span class="flow-node__menu-label">Tools</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="skills" aria-pressed="false" title="Skills — какие специализированные способности у меня есть: набор инструкций и навыков под конкретные задачи">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🎓</span>
                                    <span class="flow-node__menu-label">Skills</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="agents" aria-pressed="false" title="Agents — каких других агентов я могу привлечь: доступные субагенты и правила их использования">
                                    <span class="flow-node__menu-icon" aria-hidden="true">👥</span>
                                    <span class="flow-node__menu-label">Agents</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="memory" aria-pressed="false" title="Memory — что я помню: сохраняемый контекст, факты, предпочтения и накопленные знания между сессиями">
                                    <span class="flow-node__menu-icon" aria-hidden="true">💾</span>
                                    <span class="flow-node__menu-label">Memory</span>
                                </button>
                                <button type="button" class="flow-node__menu-item" data-panel="permissions" aria-pressed="false" title="Permissions — что мне разрешено: ограничения и политики доступа к файлам, shell, сети, внешним действиям и другим ресурсам">
                                    <span class="flow-node__menu-icon" aria-hidden="true">🔐</span>
                                    <span class="flow-node__menu-label">Permissions</span>
                                </button>
                            </nav>
                            <div class="flow-node__main">
                                <div class="flow-node__header">
                                    <span class="flow-node__titles">
                                        <span class="flow-node__title-row">
                                            <span class="flow-node__title">Backend developer</span>
                                        </span>
                                        <span class="flow-node__subtitle">Server &amp; API · Entry point</span>
                                    </span>
                                </div>
                                <div class="flow-node__body">The starting point of the Backend flow: everything the backend developer builds grows from this node.</div>
                                <div class="flow-node__footer flow-node__footer--controls">
                                    <select class="flow-node__control flow-node__provider" aria-label="Provider"></select>
                                    <select class="flow-node__control flow-node__model" aria-label="Model"></select>
                                    <select class="flow-node__control flow-node__effort" aria-label="Effort"></select>
                                </div>
                            </div>
                            <div class="flow-node__panel flow-node__panel--mcp" hidden>
                                <div class="flow-node__panel-title flow-node__panel-title--with-action">
                                    <span>MCP servers</span>
                                    <button type="button" class="flow-node__panel-file" data-file="PROJECTS/Flow/profiles/Backend developer/config.yaml" title="Open config.yaml" aria-label="Open config.yaml">📄</button>
                                </div>
                                <input type="search" class="flow-node__mcp-search" placeholder="Search MCP…" aria-label="Search MCP">
                                <div class="flow-node__mcp-list"></div>
                            </div>
                            <div class="flow-node__panel flow-node__panel--prompt" hidden>
                                <div class="flow-node__panel-title flow-node__panel-title--with-action">
