                    </template>
                    <template id="flowNodeTemplate">
                        <div class="flow-node">
                            <div class="flow-node__footer flow-node__footer--controls">
                                <select class="flow-node__control flow-node__type" aria-label="Node type" style="color:#5aa9ff">
                                    <option value="question" style="color:#5aa9ff">Quastion</option>
                                    <option value="action" style="color:#4caf50">Action</option>
                                    <option value="ask_human" style="color:#ff9800">Ask Human</option>
                                    <option value="system" style="color:#c084fc">System</option>
                                    <option value="agent" style="color:#26c6da">Agent</option>
                                </select>
                                <button type="button" class="flow-node__control flow-node__context-toggle" aria-pressed="true" aria-label="Context: on">
                                    <span class="flow-node__context-toggle-track"><span class="flow-node__context-toggle-thumb">C</span></span>
                                </button>
                                <span class="flow-node__scope">
                                    <button type="button" class="flow-node__scope-btn" aria-label="Who can see the node" title="Who can see the node">🔒</button>
                                    <div class="flow-node__scope-menu" hidden>
                                        <button type="button" class="flow-node__scope-item" data-scope="locked">🔒 Locked</button>
                                        <button type="button" class="flow-node__scope-item" data-scope="user">👤 User</button>
                                        <button type="button" class="flow-node__scope-item" data-scope="system">🖥️ System</button>
                                    </div>
                                </span>
                            </div>
                            <div class="flow-node__footer flow-node__footer--controls">
                                <select class="flow-node__control flow-node__provider" aria-label="Provider"></select>
                                <select class="flow-node__control flow-node__model" aria-label="Model"></select>
                                <select class="flow-node__control flow-node__effort" aria-label="Effort"></select>
                            </div>
                            <div class="flow-node__header flow-node__header--stacked">
                                <span class="flow-node__title-line">
                                    <span class="flow-node__avatar-picker">
                                        <button type="button" class="flow-node__avatar" aria-label="Node icon" title="Node icon">🧩</button>
                                        <div class="flow-node__avatar-menu" hidden>
                                            <button type="button" class="flow-node__avatar-item" data-avatar="🧩">🧩</button>
                                            <button type="button" class="flow-node__avatar-item" data-avatar="❓">❓</button>
                                            <button type="button" class="flow-node__avatar-item" data-avatar="⚙️">⚙️</button>
                                            <button type="button" class="flow-node__avatar-item" data-avatar="👤">👤</button>
                                            <button type="button" class="flow-node__avatar-item" data-avatar="🤖">🤖</button>
                                            <button type="button" class="flow-node__avatar-item" data-avatar="📝">📝</button>
                                            <button type="button" class="flow-node__avatar-item" data-avatar="🔀">🔀</button>
                                            <button type="button" class="flow-node__avatar-item" data-avatar="✅">✅</button>
                                        </div>
                                    </span>
                                    <span class="flow-node__titles">
                                        <span class="flow-node__title-row">
                                            <span class="flow-node__title">New node</span>
                                        </span>
                                        <span class="flow-node__subtitle">Placeholder</span>
                                    </span>
                                </span>
                            </div>
                            <div class="flow-node__body">A template node inserted on an edge.</div>
                            <div class="flow-node__questions">
                                <div class="flow-node__question"><span class="flow-node__question-handle" aria-hidden="true">⠿</span><span class="flow-node__question-text" contenteditable="true" data-placeholder="Question"></span></div>
                                <button type="button" class="flow-node__questions-add" title="Add question">Add</button>
                            </div>
                            <button type="button" class="flow-node__add-bottom" title="Add a node (or drag onto another node to connect)">+</button>
                            <button type="button" class="flow-node__add-right" title="Add a node (or drag onto another node to connect)">+</button>
                        </div>
                    </template>
                </div>
            </div>
        </div>
