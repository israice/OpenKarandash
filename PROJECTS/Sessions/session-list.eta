<% /* Список сессий панели Sessions. Подменяется целиком по hx-swap-oob, поэтому
    кто сейчас выбран (aria-current) и что выполняется прямо сейчас глазами
    браузера (плейсхолдер новой сессии, свежий running) сервер не знает — это
    досчитывает браузер в обработчике htmx:oobAfterSwap сразу после подмены
    (sessions-panel.js). */ %>
<ul class="session-list" id="sessionList" hx-swap-oob="true">
    <% if (!it.sessions.length) { %>
        <li class="session-empty">No sessions yet</li>
    <% } %>
    <% it.sessions.forEach((session) => { %>
        <li class="session-row">
            <button type="button" class="session-item" data-session-id="<%= session.id %>"<% if (session.running) { %> data-running="1"<% } %>>
                <% /* блок превью рисуем, только когда оно реально есть: пустой
                    плейсхолдер съедал место у заголовка. Ширину самого блока см.
                    в session-item__thumb (sessions.css) — там же объяснение,
                    почему не 96px */ %>
                <% if (session.thumb) { %>
                    <span class="session-item__thumb" aria-hidden="true">
                        <img class="session-item__thumb-img" alt="" src="<%= session.thumb %>">
                    </span>
                <% } %>
                <span class="session-item__body">
                    <span class="session-item__title"><%= session.title %></span>
                    <% if (session.live) { %>
                        <% /* сессия активна прямо сейчас — data-started/data-base-ms
                            дают клиенту (sessions-panel.js, tickLiveDurations) всё
                            нужное, чтобы досчитывать секунды между подменами
                            фрагмента, а не ждать следующего опроса */ %>
                        <span class="session-item__meta session-item__meta--live" data-tokens="<%= session.tokensText %>" data-base-ms="<%= session.baseMs %>" data-started="<%= session.startedAt %>"><%= session.meta %></span>
                    <% } else { %>
                        <span class="session-item__meta"><%= session.meta %></span>
                    <% } %>
                </span>
            </button>
            <% if (session.desktopUrl) { %>
                <a class="session-desktop" href="<%= session.desktopUrl %>" target="_blank" rel="noopener" title="Open Linux desktop" aria-label="Open Linux desktop for <%= session.title %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path>
                    </svg>
                </a>
            <% } %>
            <button type="button" class="session-copy" data-copy-id="<%= session.id %>" title="Copy a link to this session" aria-label="Copy a link to this session: <%= session.title %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
            </button>
            <button type="button" class="session-delete" data-delete-id="<%= session.id %>" title="Delete session" aria-label="Delete session: <%= session.title %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
            </button>
        </li>
    <% }) %>
</ul>
