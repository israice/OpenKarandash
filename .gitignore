.env
.playwright-mcp
/DATA/
/node_modules/
/.agents/

# Hermes-стек (OpenKarandash-ykb): claude-bridge — npm нужен только опциональному
# ACP-бэкенду, hermes-home — рантайм-данные конкретного запуска Hermes (сессии,
# конфиг), logs — его же логи
claude-bridge/node_modules/
claude-bridge/__pycache__/
claude-bridge/claude-config/
/hermes-home/
/logs/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Beads task tracking (ephemeral)
.beads/
.mcp.json

# то, что pi заводит в папке профиля работника сам (ключи и его сессии)
/PROJECTS/Flow/profiles/*/auth.json
/PROJECTS/Flow/profiles/*/sessions/
/PROJECTS/Flow/profiles/*/npm/
/PROJECTS/Flow/profiles/*/git/

# git worktree'ы агентов — сами по себе отдельные git-репозитории, не часть дерева
/.worktrees/
/.claude/worktrees/
