.env
.playwright-mcp
/DATA/
/node_modules/
/.agents/

# Hermes-стек (OpenKarandash-ykb): hermes — код hermes-agent, его не храним, а
# клонируем/обновляем с github.com/NousResearch/hermes-agent при старте сервера
# (SYSTEM/core/hermes-stack.js); в git остаются только наши настройки к нему
# (docker-compose.hermes.yml, hermes-home.config.example.yaml, .env.example).
# hermes-home —
# рантайм-данные конкретного запуска Hermes (сессии, конфиг), logs — его же логи
/hermes/
# jev-ultrafast (browser-use) — чужой код для управления браузером, клонируем сами
# (PROJECTS/Browser/README.md); в git — только наша обвязка в PROJECTS/Browser
/jev-ultrafast/
claude-bridge/__pycache__/
/hermes-home/
/logs/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Beads task tracking (ephemeral)
.beads/
.mcp.json

# то, что pi заводит в папке профиля работника сам (ключи и его сессии)
/PROJECTS/Flow/profiles/*/auth.json
/PROJECTS/Flow/profiles/*/sessions/
/PROJECTS/Flow/profiles/*/npm/
/PROJECTS/Flow/profiles/*/git/

# git worktree'ы агентов — сами по себе отдельные git-репозитории, не часть дерева
/.worktrees/
/.claude/worktrees/
