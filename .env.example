# Образец корневого .env. Сам .env в git не попадает.
#
# Заполнять руками ничего не нужно: сервер при первом запуске заводит .env
# сам, а сторож дописывает недостающие ключи Hermes-стека с генерированными
# секретами. Этот файл — только чтобы видеть полный набор ключей.

# Порт нашего сервера (строго этот, соседние не подбираются)
PORT=3001

# ── Hermes-стек (DOCS/decisions/029); HERMES_STACK=0 выключает его целиком ──
HERMES_STACK=1
# проверка и установка системных зависимостей при старте (git, python, Docker,
# claude CLI и вход в него; SYSTEM/core/host-deps.js); HOST_DEPS=0 выключает
HOST_DEPS=1
# откуда сторож берёт код Hermes (hermes/ в git не хранится): репозиторий и
# ветка/тег; пусто — апстрим NousResearch/hermes-agent, main
HERMES_REPO=
HERMES_REF=
# общий секрет claude-bridge (хост) и Hermes; тот же в claude-bridge/.env
CLAUDE_BRIDGE_TOKEN=
# как контейнер Hermes видит бридж на хосте (порт — из claude-bridge/.env)
CLAUDE_BRIDGE_URL=http://host.docker.internal:8788/v1
# ключ agent API самого Hermes (:8642) — им же ходит наш сервер
API_SERVER_KEY=
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
# адрес и ключ agent API Hermes для коннектора hermes в нашем сервере
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
# владелец файлов hermes-home/ внутри контейнера (свои id -u / id -g)
HERMES_UID=
HERMES_GID=

# ── настройки сервера, которые он допишет сам ──
# SCREENSHOT_SCREEN=0
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_USER_IDS=
# CLAUDE_BIN=
# OBSIDIAN_VAULT=
