# Образец корневого .env. Сам .env в git не попадает.
#
# Заполнять руками ничего не нужно: сервер при первом запуске заводит .env
# сам. Этот файл — только чтобы видеть полный набор ключей.

# Порт нашего сервера (строго этот, соседние не подбираются)
PORT=3001

# проверка и установка системных зависимостей при старте (git, python;
# SYSTEM/core/host-deps.js); HOST_DEPS=0 выключает
HOST_DEPS=1
# когда агент падает посреди работы, её подхватывает следующий подключённый;
# AGENT_FALLBACK=0 выключает
AGENT_FALLBACK=1

# ── настройки сервера, которые он допишет сам ──
# SCREENSHOT_SCREEN=0
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_USER_IDS=
# OPENCODE_BIN=
# OBSIDIAN_VAULT=