# Образец корневого .env. Сам .env в git не попадает.
#
# Заполнять руками ничего не нужно: сервер при первом запуске заводит .env
# сам. Этот файл — только чтобы видеть полный набор ключей.

# Порт нашего сервера (строго этот, соседние не подбираются)
PORT=3001

# проверка и установка системных зависимостей при старте (git, python;
# SYSTEM/core/host-deps.js); HOST_DEPS=0 выключает
HOST_DEPS=1

# Docker deployments check GitHub for validated main-branch updates and apply
# them after active turns finish. Set to 0 to disable; polling defaults to 60s.
# GITHUB_AUTO_UPDATE=1
# GITHUB_UPDATE_POLL_MS=60000

# ── настройки сервера, которые он допишет сам ──
# SCREENSHOT_SCREEN=0
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_USER_IDS=
# PI_BIN=
# OBSIDIAN_VAULT=

# ── per-chat Linux desktop integration (optional) ──
# Enable after the desktop manager is running and reachable.
# DESKTOP_ENABLED=1
# DESKTOP_MANAGER_URL=http://host.docker.internal:8080
# DESKTOP_MANAGER_TOKEN=
# DESKTOP_OPENCODE_BIN=opencode
# DESKTOP_REPOSITORY_URL=https://github.com/OWNER/REPOSITORY.git
# DESKTOP_BASE_BRANCH=main
# DESKTOP_WORKSPACE=/home/desktop/workspace
# DESKTOP_GIT_NAME=OpenKarandash worker
# DESKTOP_GIT_EMAIL=openkarandash-worker@localhost
# DESKTOP_GITHUB_TOKEN=           # repo-scoped token for clone, push and PR creation
# DESKTOP_GIT_PUSH=1
